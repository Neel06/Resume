
# ============================================================
# Angular 21 - Production Ready .gitignore
# ============================================================

# ------------------------------------------------------------
# 1. Node.js Dependencies
# ------------------------------------------------------------
node_modules/
**/node_modules/

# ------------------------------------------------------------
# 2. Angular Build Outputs
# ------------------------------------------------------------
dist/
build/
out-tsc/
.angular/
.angular/cache/
.angular/prerendered-routes.json

# ------------------------------------------------------------
# 3. Temporary Files and Caches
# ------------------------------------------------------------
.cache/
.tmp/
temp/
tmp/
*.tmp
*.temp
*.tsbuildinfo
.eslintcache
.parcel-cache/
.turbo/

# ------------------------------------------------------------
# 4. Logs
# ------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------
# 5. Environment Files and Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample

# Private environment configurations
src/environments/environment.local.ts
src/environments/environment.*.local.ts
src/environments/environment.secret.ts
src/environments/environment.secrets.ts

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.crt

# ------------------------------------------------------------
# 6. IDE and Editor Configurations
# ------------------------------------------------------------

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains IDEs
.idea/
*.iml

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------------------------
# 7. Operating System Files
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.nfs*

# ------------------------------------------------------------
# 8. Testing and Code Coverage
# ------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.lcov

# ------------------------------------------------------------
# 9. Package Manager Caches
# ------------------------------------------------------------
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------
# 10. Local Development Files
# ------------------------------------------------------------
*.local
*.bak
*.backup
*.orig
*.swp
*.swo
*.swn

# ------------------------------------------------------------
# 11. Deployment and Hosting
# ------------------------------------------------------------
.vercel/
.netlify/
.firebase/
.serverless/
.aws-sam/

# ------------------------------------------------------------
# 12. Miscellaneous
# ------------------------------------------------------------
*.pid
*.pid.lock
*.seed
*.tgz
